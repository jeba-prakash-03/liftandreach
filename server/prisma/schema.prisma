generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model Category {
  id               Int        @id @default(autoincrement())
  parentId         Int?       @map("parent_id")
  name             String
  slug             String     @unique
  image            String?
  description      String?    @db.Text
  applications     Json?
  industries       Json?
  applicationAreas Json?      @map("application_areas")
  sortOrder        Int        @default(0) @map("sort_order")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  coverPhoto       String?    @map("cover_photo")
  parent           Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children         Category[] @relation("CategoryHierarchy")
  products         Product[]

  @@index([parentId], map: "categories_parent_id_fkey")
  @@map("categories")
}

model Product {
  id               Int           @id @default(autoincrement())
  categoryId       Int           @map("category_id")
  code             String?
  name             String
  slug             String        @unique
  shortDesc        String?       @map("short_desc") @db.Text
  description      String?       @db.Text
  applications     Json?
  industries       Json?
  applicationAreas Json?         @map("application_areas")
  specTables       Json?         @map("spec_tables")
  notes            Json?
  images           Json?
  isActive         Boolean       @default(true) @map("is_active")
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  internal_notes   String?       @db.Text
  highlights       Json?
  enquiries        Enquiry[]
  enquiryItems     EnquiryItem[]
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId], map: "products_category_id_fkey")
  @@map("products")
}

model Enquiry {
  id        Int           @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String        @db.Text
  productId Int?          @map("product_id")
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  product   Product?      @relation(fields: [productId], references: [id])
  items     EnquiryItem[]

  @@index([productId], map: "enquiries_product_id_fkey")
  @@map("enquiries")
}

model EnquiryItem {
  id        Int      @id @default(autoincrement())
  enquiryId Int      @map("enquiry_id")
  productId Int      @map("product_id")
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([enquiryId], map: "enquiry_items_enquiry_id_fkey")
  @@index([productId], map: "enquiry_items_product_id_fkey")
  @@map("enquiry_items")
}

model HeroSlide {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String?
  badge     String?
  image     String
  ctaText   String?  @default("View Products") @map("cta_text")
  ctaLink   String?  @default("/products") @map("cta_link")
  ctaText2  String?  @default("Get a Quote") @map("cta_text_2")
  ctaLink2  String?  @default("/contact") @map("cta_link_2")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hero_slides")
}

model Setting {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  value        String   @db.Text
  description  String?
  updatedAt    DateTime @updatedAt @map("updated_at")
  hero_photo   String?  @db.VarChar(255)
  custom_photo String?  @db.VarChar(255)

  @@map("settings")
}

model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model images {
  id         Int      @id @default(autoincrement())
  path       String   @unique(map: "path") @db.VarChar(255)
  width      Int      @default(0)
  height     Int      @default(0)
  enhanced   Boolean  @default(false)
  focal_x    Int?     @default(50)
  focal_y    Int?     @default(50)
  updated_at DateTime @default(now())
}

model site_content {
  id         Int      @id @default(autoincrement())
  section    String   @unique(map: "section")
  data       Json
  updated_at DateTime @default(now())
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}
