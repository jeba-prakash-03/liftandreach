# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Native Local MySQL 8
DATABASE_URL="mysql://root:your_mysql_password@127.0.0.1:3306/liftandreach"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Default Admin Seed Credentials
ADMIN_EMAIL="admin@liftandreach.in"
ADMIN_PASSWORD="ChangeThisPassword123!"
ADMIN_NAME="System Administrator"

# SMTP Nodemailer Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="liftnreach@gmail.com"
SMTP_PASS="your_smtp_app_password"
NOTIFICATION_EMAIL="liftnreach@gmail.com"
